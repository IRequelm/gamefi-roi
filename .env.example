GAMEFI_MARKET_DATA_PRICE_FRESHNESS_SECONDS=300
GAMEFI_COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
GAMEFI_COINGECKO_API_KEY=
GAMEFI_ALCOR_BASE_URL=https://wax.alcor.exchange/api/v2
