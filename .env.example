# Local development only. Do not commit a real .env file.
GAMEFI_ENVIRONMENT=local
GAMEFI_DATABASE_URL=postgresql+psycopg://gamefi:gamefi_local_password@localhost:5432/gamefi_roi
GAMEFI_API_TITLE=GameFi ROI API
GAMEFI_LOG_LEVEL=INFO
GAMEFI_ALLOW_SQLITE_FOR_TESTS=false
