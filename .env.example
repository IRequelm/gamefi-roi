# Local development only. Do not commit a real .env file.
GAMEFI_ENVIRONMENT=local
GAMEFI_DATABASE_URL=postgresql+psycopg://gamefi:gamefi_local_password@localhost:5432/gamefi_roi
GAMEFI_API_TITLE=GameFi ROI API
GAMEFI_LOG_LEVEL=INFO
GAMEFI_ALLOW_SQLITE_FOR_TESTS=false
GAMEFI_DATABASE_POOL_SIZE=5
GAMEFI_DATABASE_MAX_OVERFLOW=2
GAMEFI_DATABASE_POOL_TIMEOUT_SECONDS=30
GAMEFI_DATABASE_POOL_RECYCLE_SECONDS=1800
GAMEFI_ALLOWED_CORS_ORIGINS=
GAMEFI_SECURITY_HEADERS_ENABLED=true
GAMEFI_PUBLIC_BASE_URL=http://localhost:8000
GAMEFI_GA_MEASUREMENT_ID=
GAMEFI_SENTRY_DSN=
GAMEFI_SENTRY_FRONTEND_DSN=
GAMEFI_SENTRY_ENVIRONMENT=
GAMEFI_SENTRY_RELEASE=
GAMEFI_SENTRY_TRACES_SAMPLE_RATE=0.02
GAMEFI_SENTRY_ERROR_SAMPLE_RATE=1.0
GAMEFI_POSTHOG_PROJECT_API_KEY=
GAMEFI_POSTHOG_HOST=https://us.i.posthog.com
GAMEFI_POSTHOG_TIMEOUT_SECONDS=2
# Optional Growth/Operations AI provider. Keep the real API key only in secrets.
NVIDIA_API_KEY=
GAMEFI_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GAMEFI_NVIDIA_MODEL=openai/gpt-oss-120b
GAMEFI_NVIDIA_TIMEOUT_SECONDS=60
GAMEFI_NVIDIA_MAX_RETRIES=2
GAMEFI_NVIDIA_MAX_TOKENS=2048
GAMEFI_YOUTUBE_OAUTH_CLIENT_SECRETS_FILE=data/local/youtube/client_secret.json
GAMEFI_YOUTUBE_OAUTH_TOKEN_FILE=data/local/youtube/token.json
GAMEFI_YOUTUBE_PUBLISH_STATE_FILE=data/local/youtube/publish_state.json
GAMEFI_YOUTUBE_APPROVAL_FILE=data/local/youtube/approvals.json
GAMEFI_YOUTUBE_CONTENT_PACK_FILE=distribution/content_packs/learning_batch_001.json
GAMEFI_YOUTUBE_QUEUE_FILE=distribution/publish_queue/youtube_publish_queue.json
GAMEFI_YOUTUBE_CHANNEL_HANDLE=@GamCryp
GAMEFI_YOUTUBE_MAX_RETRIES=2
GAMEFI_PUBLIC_X_URL=https://x.com/GamCryp
# Operator-only X publishing. Keep client secrets and token files outside Git.
GAMEFI_X_CLIENT_ID=
GAMEFI_X_CLIENT_SECRET=
GAMEFI_X_REDIRECT_URI=http://127.0.0.1:8765/callback
GAMEFI_X_CONTENT_PACK_FILE=distribution/content_packs/learning_batch_001.json
GAMEFI_X_QUEUE_FILE=distribution/publish_queue/x_publish_queue.json
GAMEFI_X_TOKEN_FILE=data/local/x/token.json
GAMEFI_X_APPROVAL_FILE=data/local/x/approvals.json
GAMEFI_X_PUBLICATION_FILE=data/local/x/publications.json
GAMEFI_X_OAUTH_PENDING_FILE=data/local/x/oauth_pending.json
GAMEFI_X_PUBLISH_LOCK_FILE=data/local/x/publish.lock
GAMEFI_X_HTTP_TIMEOUT_SECONDS=20
GAMEFI_X_MAX_SNAPSHOT_AGE_SECONDS=1800
GAMEFI_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@GamCryp
GAMEFI_PUBLIC_CONTACT_EMAIL=info@gamcryp.com
GAMEFI_INDEXNOW_KEY=
GAMEFI_GOOGLE_SITE_VERIFICATION=
GAMEFI_BING_SITE_VERIFICATION=
GAMEFI_OPERATOR_USERNAME=
GAMEFI_OPERATOR_PASSWORD=
GAMEFI_REFERRAL_REVERIFY_DAYS=30
GAMEFI_REFERRAL_PENDING_RECHECK_DAYS=14
GAMEFI_SCHEDULER_CADENCE_MINUTES=30
GAMEFI_PRODUCTION_HARD_STALE_SECONDS=1800
GAMEFI_MARKET_DATA_HTTP_TIMEOUT_SECONDS=10
GAMEFI_MARKET_DATA_HTTP_MAX_RETRIES=2
GAMEFI_MARKET_DATA_PRICE_FRESHNESS_SECONDS=300
GAMEFI_COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
GAMEFI_COINGECKO_API_KEY=
GAMEFI_ALCOR_BASE_URL=https://wax.alcor.exchange/api/v2
GAMEFI_ATOMICASSETS_BASE_URL=https://wax.api.atomicassets.io
GAMEFI_WAX_MARKET_OBSERVATION_FRESHNESS_SECONDS=300
# Local development may use the public DFK RPC below. Production must override this
# with a dedicated provider URL set through platform secrets.
GAMEFI_DFK_CHAIN_RPC_URL=https://subnets.avax.network/defi-kingdoms/dfk-chain/rpc
GAMEFI_DFK_CHAIN_OBSERVATION_FRESHNESS_SECONDS=300
GAMEFI_SPLINTERLANDS_BASE_URL=https://api.splinterlands.com
GAMEFI_SPLINTERLANDS_OBSERVATION_FRESHNESS_SECONDS=300
