GAMEFI_X_MAX_SNAPSHOT_AGE_SECONDS=1800
GAMEFI_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@GamCryp
GAMEFI_PUBLIC_CONTACT_EMAIL=info@gamcryp.com
GAMEFI_INDEXNOW_KEY=
GAMEFI_GOOGLE_SITE_VERIFICATION=
GAMEFI_BING_SITE_VERIFICATION=
