# Local development only. Do not commit a real .env file.
GAMEFI_ENVIRONMENT=local
GAMEFI_DATABASE_URL=postgresql+psycopg://gamefi:gamefi_local_password@localhost:5432/gamefi_roi
GAMEFI_API_TITLE=GameFi ROI API
GAMEFI_LOG_LEVEL=INFO
GAMEFI_ALLOW_SQLITE_FOR_TESTS=false
GAMEFI_DATABASE_POOL_SIZE=5
GAMEFI_DATABASE_MAX_OVERFLOW=2
GAMEFI_DATABASE_POOL_TIMEOUT_SECONDS=30
GAMEFI_DATABASE_CONNECT_TIMEOUT_SECONDS=10
GAMEFI_DATABASE_POOL_RECYCLE_SECONDS=1800
GAMEFI_ALLOWED_CORS_ORIGINS=
GAMEFI_SECURITY_HEADERS_ENABLED=true
GAMEFI_PUBLIC_BASE_URL=http://localhost:8000
GAMEFI_GA_MEASUREMENT_ID=
GAMEFI_SENTRY_DSN=
GAMEFI_SENTRY_FRONTEND_DSN=
GAMEFI_SENTRY_ENVIRONMENT=
GAMEFI_SENTRY_RELEASE=
GAMEFI_SENTRY_TRACES_SAMPLE_RATE=0.02
GAMEFI_SENTRY_ERROR_SAMPLE_RATE=1.0
GAMEFI_POSTHOG_PROJECT_API_KEY=
GAMEFI_POSTHOG_HOST=https://us.i.posthog.com
GAMEFI_POSTHOG_TIMEOUT_SECONDS=2
# Optional Growth/Operations AI provider. Keep the real API key only in secrets.
NVIDIA_API_KEY=
GAMEFI_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GAMEFI_NVIDIA_MODEL=openai/gpt-oss-120b
GAMEFI_NVIDIA_TIMEOUT_SECONDS=60
GAMEFI_NVIDIA_MAX_RETRIES=2
GAMEFI_NVIDIA_MAX_TOKENS=2048
GAMEFI_YOUTUBE_OAUTH_CLIENT_SECRETS_FILE=data/local/youtube/client_secret.json
GAMEFI_YOUTUBE_OAUTH_TOKEN_FILE=data/local/youtube/token.json
GAMEFI_YOUTUBE_PUBLISH_STATE_FILE=data/local/youtube/publish_state.json
GAMEFI_YOUTUBE_APPROVAL_FILE=data/local/youtube/approvals.json
GAMEFI_YOUTUBE_CONTENT_PACK_FILE=distribution/content_packs/learning_batch_001.json
GAMEFI_YOUTUBE_QUEUE_FILE=distribution/publish_queue/youtube_publish_queue.json
GAMEFI_YOUTUBE_CHANNEL_HANDLE=@GamCryp
GAMEFI_YOUTUBE_MAX_RETRIES=2
# ElevenLabs is manual/operator-triggered. Keep the API key only in the local ignored .env.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
ELEVENLABS_OUTPUT_DIRECTORY=data/local/youtube/narration
GAMEFI_DISTRIBUTION_LIVE=false
GAMEFI_X_PUBLISHING_MODE=manual
GAMEFI_SHORT_AUDIO_FALLBACK=music_only
GAMEFI_DISTRIBUTION_VIDEO_DIR=data/local/youtube/videos
GAMEFI_DISTRIBUTION_THUMBNAIL_DIR=data/local/youtube
GAMEFI_DISTRIBUTION_WORKER_STATE_FILE=data/local/distribution/worker_state.json
GAMEFI_DISTRIBUTION_HEARTBEAT_FILE=data/local/distribution/worker_heartbeat.json
GAMEFI_DISTRIBUTION_REFILL_ENABLED=false
GAMEFI_SHORT_YOUTUBE_HANDOFF_REFILL_ENABLED=false
GAMEFI_SHORT_YOUTUBE_REFILL_BATCH=1
GAMEFI_DISTRIBUTION_LOCK_FILE=data/local/distribution/worker.lock
GAMEFI_DISTRIBUTION_BUFFER_SIZE=3
GAMEFI_DISTRIBUTION_REFILL_COOLDOWN_HOURS=24
GAMEFI_DISTRIBUTION_REFILL_STATE_FILE=data/local/distribution/refill_state.json
GAMEFI_DISTRIBUTION_HANDOFF_FILE=distribution/publish_queue/next_publish_queue.json
GAMEFI_DISTRIBUTION_RANKINGS_URL=https://gamcryp.com/api/v1/rankings?limit=100
GAMEFI_DISTRIBUTION_OPPORTUNITIES_URL=https://gamcryp.com/api/v1/opportunities?limit=100
GAMEFI_MANUAL_X_OUTBOX_FILE=distribution/manual_outbox/x_manual_ready.json
GAMEFI_X_MANUAL_OUTBOX_STALE_HOURS=24
# Optional operator email for the exact GREEN manual X post. Use an app
# password, never a normal mailbox password. Disabled unless explicitly true.
GAMEFI_X_MANUAL_EMAIL_ENABLED=false
GAMEFI_X_MANUAL_EMAIL_TO=
GAMEFI_X_MANUAL_EMAIL_FROM=
GAMEFI_X_MANUAL_EMAIL_SMTP_HOST=smtp.gmail.com
GAMEFI_X_MANUAL_EMAIL_SMTP_PORT=587
GAMEFI_X_MANUAL_EMAIL_SMTP_USERNAME=
GAMEFI_X_MANUAL_EMAIL_SMTP_PASSWORD=
GAMEFI_X_MANUAL_EMAIL_STATE_FILE=data/local/distribution/x_email_state.json
GAMEFI_X_AMPLIFICATION_EMAIL_STATE_FILE=data/local/distribution/x_amplification_email_state.json

# Discovery candidate approval. New candidates remain pending until an exact
# SITEYE_EKLE <token> reply is received. Disabled by default.
GAMEFI_DISCOVERY_APPROVAL_EMAIL_ENABLED=false
GAMEFI_DISCOVERY_X_ENABLED=false
GAMEFI_DISCOVERY_GOOGLE_KEYWORDS=GameFi,DePIN,crypto node,GPU compute,storage node
GAMEFI_DISCOVERY_GOOGLE_GEO=US
GAMEFI_DISCOVERY_GOOGLE_TRENDS_COOKIE_FILE=data/local/discovery/google_trends.cookies
GAMEFI_DISCOVERY_APPROVAL_EMAIL_TO=
GAMEFI_DISCOVERY_APPROVAL_EMAIL_FROM=
GAMEFI_DISCOVERY_APPROVAL_SMTP_HOST=smtp.gmail.com
GAMEFI_DISCOVERY_APPROVAL_SMTP_PORT=587
GAMEFI_DISCOVERY_APPROVAL_SMTP_USERNAME=
GAMEFI_DISCOVERY_APPROVAL_SMTP_PASSWORD=
GAMEFI_DISCOVERY_APPROVAL_IMAP_HOST=imap.gmail.com
GAMEFI_DISCOVERY_APPROVAL_IMAP_PORT=993
GAMEFI_DISCOVERY_APPROVAL_IMAP_USERNAME=
GAMEFI_DISCOVERY_APPROVAL_IMAP_PASSWORD=
GAMEFI_DISCOVERY_APPROVAL_IMAP_FOLDER=INBOX
GAMEFI_DISCOVERY_APPROVAL_OUTBOX_DIR=data/local/discovery/approval_outbox
GAMEFI_DISCOVERY_GOOGLE_NEWS_MAX_AGE_DAYS=180
GAMEFI_X_AMPLIFICATION_AUTO_REPOST=false
GAMEFI_X_AMPLIFICATION_FEED_FILE=distribution/inbox/x_signal_feed.json
GAMEFI_X_AMPLIFICATION_WHITELIST_FILE=config/distribution/x_source_whitelist.json
